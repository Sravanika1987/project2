{
  "version": 2,
  "builds": [
    {
      "src": "backend code/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend code/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "outputDirectory": ".",
  "installCommand": "cd 'backend code' && npm install"
}
